#pragma once

// Rename this file to arduino_secrets.h and fill in your own values.
#define WIFI_SSID "Your WiFi name"
#define WIFI_PASSWORD "Your WiFi password"

// Hosted Railway backend. For local development on the same WiFi, use your
// computer IP instead, set port 8000, and set CHAT_SERVER_USE_TLS to 0.
#define CHAT_SERVER_HOST "lulu-production-8cfe.up.railway.app"
#define CHAT_SERVER_PORT 443
#define CHAT_SERVER_USE_TLS 1

// Default output is PWM on AUDIO_PIN for a PAM8403 analog amplifier.
// If you add an I2S DAC/amp, uncomment this and set the I2S pins in the sketch.
// #define AUDIO_OUTPUT_MODE AUDIO_OUTPUT_I2S

// Optional memory/cost controls. Shorter recordings use less ESP32 RAM and
// reduce the chance of accidental server/OpenAI requests.
// #define RECORD_MAX_SECONDS 5
// #define RECORD_MIN_BUFFER_SECONDS 2
// #define AUTO_FOLLOWUP_ENABLED 0
