// Bible recorded-audio MP3 playback needs the ESP32 Helix MP3 decoder library.
// Leave disabled until the library is installed and verified in Arduino IDE.
// Without MP3DecoderHelix.h, the firmware still compiles but Bible MP3 playback stays disabled.
// #define ENABLE_BIBLE_MP3_HELIX 1

