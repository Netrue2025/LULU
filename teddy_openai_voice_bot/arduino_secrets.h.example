// Optional touch/DHT tuning.
// The pictured TTP223 touch module is normally LOW idle and HIGH when touched.
// #define TOUCH_ACTIVE_LEVEL HIGH
// TTP223 actively drives OUT, so plain INPUT is fastest on most boards. Set to 1 if your wiring needs ESP32 pullup/pulldown.
// #define TOUCH_INPUT_PULL_ENABLED 0
// Latches short touch pulses so listening mode starts even when the loop is busy with SD/cloud work.
// #define TOUCH_INTERRUPT_ENABLED 1
// Keep the touch beep short so listening starts immediately.
// #define TOUCH_CONFIRM_BEEP_MS 35
// Short double tap on the touch sensor plays the next /Music WAV directly from SD.
// When WiFi is connected, one touch starts listening immediately; double tap music is offline-only.
