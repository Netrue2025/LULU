#pragma once

// Rename this file to arduino_secrets.h and fill in your own values.
#define WIFI_SSID "Your WiFi name"
#define WIFI_PASSWORD "Your WiFi password"

// IP address of the computer running server.py on the same WiFi network.
#define CHAT_SERVER_HOST "192.168.1.100"
#define CHAT_SERVER_PORT 8000

// Default output is PWM on AUDIO_PIN for a PAM8403 analog amplifier.
// If you add an I2S DAC/amp, uncomment this and set the I2S pins in the sketch.
// #define AUDIO_OUTPUT_MODE AUDIO_OUTPUT_I2S

